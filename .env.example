# ShopSense Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# Never commit .env containing real secrets to version control.

# ── Database Configuration ──────────────────────────────────────────────────
# Local PostgreSQL default:
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/shopsense

# Docker Compose PostgreSQL credentials:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=shopsense
POSTGRES_PORT=5432

# Test database URL (used by Pytest in-memory/isolated execution):
TEST_DATABASE_URL=sqlite:///./test_shopsense.db

# ── API & Dashboard Networking ──────────────────────────────────────────────
# URL used by Streamlit dashboard to communicate with FastAPI backend:
# Local development default: http://127.0.0.1:8000
# Docker Compose internal network: http://backend:8000
API_BASE_URL=http://127.0.0.1:8000

# ── MLflow Tracking Configuration ───────────────────────────────────────────
# Local SQLite default: sqlite:///./mlflow.db
# Docker Compose service default: http://mlflow:5000
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Security & Authentication (Stage 7 / 7.1) ────────────────────────────────
# Minimum 32-character random string for cryptographic JWT signing:
SECRET_KEY=replace-with-a-secure-32-byte-hex-secret-in-production

# Administrative Bootstrap Credentials (used by bootstrap_admin.py):
ADMIN_EMAIL=admin@shopsense.internal
ADMIN_PASSWORD=AdminSecure123!
